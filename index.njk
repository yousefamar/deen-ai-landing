---
pagination:
  data: locales
  size: 1
  alias: localeCode
permalink: "{% if localeCode == 'en' %}index.html{% else %}{{ localeCode }}/index.html{% endif %}"
---
{%- set t = i18n[localeCode] -%}
{%- set isRtl = (t.dir == "rtl") -%}
{%- set baseUrl = "https://deen.ai/" -%}
{%- set pageUrl = baseUrl if localeCode == "en" else (baseUrl + localeCode + "/") -%}
{%- set joinHref = "https://wa.me/12056799898?text=" + (t.joinPrefill | urlencode) -%}
{%- set creditLink = '<a href="https://yousefamar.com" target="_blank" rel="noopener" class="font-medium text-green-900">Yousef Amar</a>' -%}
{%- set listEls = [] -%}
{%- for item in gallery -%}
{%- if not item.hidden -%}
{%- set _ = listEls.push({ "@type": "ListItem", "position": listEls.length + 1, "url": item.url, "name": item.title, "description": item.description }) -%}
{%- endif -%}
{%- endfor -%}
<!doctype html>
<html lang="{{ t.htmlLang }}" dir="{{ t.dir }}">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Auto-localize, SEO-safe: runs ONLY on the homepage "/" and only forwards to a
       locale. Locale pages never redirect, so crawlers index every version; the user's
       explicit choice (set by the switcher) is remembered and always wins. -->
  <script>
    (function () {
      try {
        if (location.pathname.replace(/index\.html$/, "") !== "/") return;
        var avail = {{ locales | dump | safe }};
        var stored = null; try { stored = localStorage.getItem("deenLocale"); } catch (e) {}
        var target = stored;
        if (!target) {
          var prefs = navigator.languages || [navigator.language] || [];
          for (var i = 0; i < prefs.length; i++) {
            var raw = (prefs[i] || "").toLowerCase(); if (!raw) continue;
            var base = raw.split("-")[0];
            var c = avail.indexOf(raw) >= 0 ? raw : (base === "zh" ? "zh" : (avail.indexOf(base) >= 0 ? base : null));
            if (c) { target = c; break; }
          }
        }
        if (target && target !== "en" && avail.indexOf(target) >= 0) location.replace("/" + target + "/");
      } catch (e) {}
    })();
  </script>

  <title>{{ t.title }}</title>
  <meta name="description" content="{{ t.metaDescription }}">
  <link rel="canonical" href="{{ pageUrl }}">
  <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1">
  <meta name="theme-color" content="#1F3938">

  <!-- hreflang alternates (reciprocal, every locale + x-default) -->
  {%- for code in locales %}
  <link rel="alternate" hreflang="{{ i18n[code].htmlLang }}" href="{{ baseUrl if code == 'en' else (baseUrl + code + '/') }}">
  {%- endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ baseUrl }}">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="deen.ai">
  <meta property="og:title" content="{{ t.ogTitle }}">
  <meta property="og:description" content="{{ t.ogDescription }}">
  <meta property="og:url" content="{{ pageUrl }}">
  <meta property="og:locale" content="{{ t.ogLocale }}">
  {%- for code in locales %}{% if code != localeCode %}
  <meta property="og:locale:alternate" content="{{ i18n[code].ogLocale }}">
  {%- endif %}{% endfor %}
  <meta property="og:image" content="https://deen.ai/og-image.png">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ t.ogImageAlt }}">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ t.ogTitle }}">
  <meta name="twitter:description" content="{{ t.ogDescription }}">
  <meta name="twitter:image" content="https://deen.ai/og-image.png">

  <!-- Icons / manifest -->
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  <link rel="stylesheet" href="/tailwind.css">
  {%- if site.downtime %}
  <link rel="stylesheet" href="/vendor/intl-tel-input/css/intlTelInput.min.css">
  <style>
    /* intl-tel-input wraps the input in .iti{display:inline-block}, which collapses the field to
       content width. Force it to fill the dialog. */
    #downDialog .iti { display: block; width: 100%; }
    /* The country dropdown opens taller than the (content-sized) dialog card. A modal <dialog>
       computes overflow:auto and would clip it, so allow the dropdown to overflow the card. */
    #downDialog { overflow: visible; }
  </style>
  {%- endif %}

  <script type="application/ld+json">
  {{ { "@context": "https://schema.org", "@type": "Organization", "name": "deen.ai", "url": "https://deen.ai/", "logo": "https://deen.ai/android-chrome-512x512.png", "description": t.jsonLdDescription } | dump | safe }}
  </script>
  <script type="application/ld+json">
  {{ { "@context": "https://schema.org", "@type": "WebSite", "name": "deen.ai", "url": "https://deen.ai/" } | dump | safe }}
  </script>
  <script type="application/ld+json">
  {{ { "@context": "https://schema.org", "@type": "CollectionPage", "name": t.jsonLdName, "url": pageUrl, "description": t.jsonLdDescription, "inLanguage": t.htmlLang, "mainEntity": { "@type": "ItemList", "numberOfItems": listEls.length, "itemListElement": listEls } } | dump | safe }}
  </script>
</head>

<body>

<!-- Language switcher: real crawlable <a> links to every locale (helps search engines
     discover all versions; lets users choose). No auto-redirect, by design. -->
<details class="fixed top-3 end-3 z-50 text-sm">
  <summary class="list-none cursor-pointer inline-flex items-center gap-1.5 rounded-full bg-white/80 px-3 py-1.5 font-medium text-gray-700 shadow ring-1 ring-gray-200 backdrop-blur hover:bg-white">
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0 0c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3M3.6 9h16.8M3.6 15h16.8"/></svg>
    <span>{{ t.name }}</span>
  </summary>
  <div class="absolute end-0 mt-2 max-h-[70vh] w-52 overflow-auto rounded-xl bg-white p-1 text-start shadow-lg ring-1 ring-gray-200">
    {%- for code in locales %}
    <a href="{{ baseUrl if code == 'en' else (baseUrl + code + '/') }}" hreflang="{{ i18n[code].htmlLang }}" lang="{{ i18n[code].htmlLang }}" dir="{{ i18n[code].dir }}" data-loc="{{ code }}" class="block rounded-lg px-3 py-1.5 hover:bg-gray-100 {% if code == localeCode %}font-semibold text-emerald-700{% else %}text-gray-700{% endif %}"{% if code == localeCode %} aria-current="true"{% endif %}>{{ i18n[code].name }}</a>
    {%- endfor %}
  </div>
</details>

<div class="min-h-svh flex flex-col bg-gradient-to-b from-cyan-50 to-green-50">
  <div class="flex-1 flex items-center justify-center px-6 py-12">
    <div class="mx-auto max-w-2xl">
        <div class="text-center">
          <div dir="ltr" class="flex flex-col sm:flex-row items-center justify-center">
            <img src="/deen.png" alt="deen.ai logo" width="64" height="64" class="w-16 mb-4 sm:mr-4 sm:mb-0">
            <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-6xl">deen.ai</h1>
          </div>
          <p class="mt-6 text-lg leading-8 text-gray-600">{{ t.heroSubtitle }}</p>
          <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-x-6">
            <button type="button" id="askBtn"
              class="inline-flex w-full sm:w-auto items-center justify-center rounded-full bg-white px-6 py-3 text-sm font-semibold text-emerald-700 shadow-md ring-1 ring-inset ring-emerald-600/25 transition hover:shadow-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600">
              <svg class="mr-2 h-5 w-5 rtl:mr-0 rtl:ml-2" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z"/></svg>
              {{ t.askButton }}</button>
            <a href="{{ joinHref }}" target="_blank" rel="noopener"
              class="inline-flex w-full sm:w-auto items-center justify-center rounded-full bg-gradient-to-br from-green-600 to-emerald-500 px-6 py-3 text-sm font-semibold text-white shadow-md transition hover:shadow-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600">
              <svg class="mr-2 h-5 w-5 fill-current rtl:mr-0 rtl:ml-2" viewBox="0 0 448 512" aria-hidden="true"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
              {{ t.joinButton }}</a>
          </div>
        </div>
    </div>
  </div>
  <svg class="mx-auto mb-6 h-9 w-9 shrink-0 text-gray-500 fill-current" viewBox="0 0 512 512" aria-hidden="true"><path d="M233.4 406.6c12.5 12.5 32.8 12.5 45.3 0l192-192c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L256 338.7 86.6 169.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l192 192z"/></svg>
</div>

<h2 class="mx-auto max-w-2xl text-center text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl mt-20">{{ t.galleryHeading }}</h2>

<div class="mx-auto max-w-2xl px-4 py-16 sm:px-6 sm:py-24 lg:max-w-7xl lg:px-8" dir="ltr">
  <div class="grid grid-cols-1 gap-y-4 sm:grid-cols-2 sm:gap-x-6 sm:gap-y-10 lg:grid-cols-3 lg:gap-x-8">

    {% for item in gallery %}
    {% if not item.hidden %}
    <div class="group relative flex flex-col overflow-hidden rounded-lg border border-gray-200 bg-white">
      <div class="aspect-h-9 aspect-w-16 bg-gray-200 group-hover:opacity-75">
        <img src="{{item.img}}" alt="{{ item.title }}" loading="lazy" decoding="async" class="h-full w-full object-cover object-top sm:h-full sm:w-full">
      </div>
      <div class="flex flex-1 flex-col space-y-2 p-4">
        <h3 class="text-md font-medium text-gray-900">
          <a href="{{item.url}}" target="_blank" rel="noopener">
            <span aria-hidden="true" class="absolute inset-0"></span>
            {{ item.title }}
          </a>
        </h3>
        <p class="text-sm text-gray-500 flex-grow">{{ item.description }}</p>
        <div class="flex gap-2 pt-2">
          {% for tag in item.tags %}
            {% if tag === 'Product' %}
              <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">{{ tag }}</span>
            {% elseif tag === 'Dataset' %}
              <span class="inline-flex items-center rounded-full bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-700/10">{{ tag }}</span>
            {% elseif tag === 'Model' %}
              <span class="inline-flex items-center rounded-full bg-yellow-50 px-2 py-1 text-xs font-medium text-yellow-800 ring-1 ring-inset ring-yellow-600/20">{{ tag }}</span>
            {% elseif tag === 'Code' %}
              <span class="inline-flex items-center rounded-full bg-purple-50 px-2 py-1 text-xs font-medium text-purple-700 ring-1 ring-inset ring-purple-700/10">{{ tag }}</span>
            {% elseif tag === 'Evaluation' %}
              <span class="inline-flex items-center rounded-full bg-pink-50 px-2 py-1 text-xs font-medium text-pink-700 ring-1 ring-inset ring-pink-700/10">{{ tag }}</span>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
    {% endif %}
    {% endfor %}

  </div>
</div>

<footer class="bg-white">
  <div class="mx-auto max-w-7xl px-6 py-12 items-center lg:px-8">
    <div class="mt-8 md:mt-0">
      <p class="text-center text-xs leading-5 text-gray-500">{{ t.footerCredit | replace("{creditLink}", creditLink) | safe }}</p>
    </div>
  </div>
</footer>

<dialog id="askDialog" class="w-[92vw] max-w-md max-h-[90vh] overflow-y-auto rounded-2xl border-0 p-0 shadow-xl backdrop:bg-gray-900/50">
  <form id="askForm" class="relative p-6 sm:p-7">
    <button type="button" id="askClose" aria-label="{{ t.askClose }}" class="absolute right-4 top-4 rtl:right-auto rtl:left-4 text-gray-400 hover:text-gray-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-600">
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/></svg>
    </button>
    <h2 class="text-center text-lg font-semibold text-gray-900">{{ t.askDialogHeading }}</h2>
    <p class="mx-auto mt-2 max-w-sm text-center text-sm leading-6 text-gray-500">{{ t.askDialogSubtitle }}</p>
    <textarea id="askText" rows="4" required maxlength="600" placeholder="{{ t.askPlaceholder }}"
      class="mt-4 block w-full resize-none rounded-md border-0 p-3 text-sm text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-green-600 text-start"></textarea>
    <div class="mt-5 flex justify-center">
      <button type="submit"
        class="inline-flex items-center justify-center rounded-full bg-gradient-to-br from-green-600 to-emerald-500 px-6 py-2.5 text-sm font-semibold text-white shadow-md transition hover:shadow-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600">
        <svg class="mr-2 h-4 w-4 fill-current rtl:mr-0 rtl:ml-2" viewBox="0 0 448 512" aria-hidden="true"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
        {{ t.askSubmit }}</button>
    </div>
  </form>
</dialog>

<script>
  (function () {
    var dlg = document.getElementById('askDialog');
    var openBtn = document.getElementById('askBtn');
    var closeBtn = document.getElementById('askClose');
    var form = document.getElementById('askForm');
    var text = document.getElementById('askText');
    if (!dlg || !openBtn || !form) return;
    openBtn.addEventListener('click', function () { dlg.showModal(); setTimeout(function () { text.focus(); }, 50); });
    closeBtn.addEventListener('click', function () { dlg.close(); });
    // Close on backdrop click: a modal <dialog> reports e.target === the dialog only for clicks
    // on its ::backdrop; clicks on children (the form) target the child, so they don't close it.
    dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var q = (text.value || '').trim();
      if (!q) return;
      window.open('https://wa.me/12056799898?text=' + encodeURIComponent(q), '_blank', 'noopener');
      dlg.close();
      form.reset();
    });
  })();
</script>

<script>
  // Remember an explicit language choice so the homepage auto-redirect always honours it.
  document.querySelectorAll("a[data-loc]").forEach(function (a) {
    a.addEventListener("click", function () {
      try { localStorage.setItem("deenLocale", a.getAttribute("data-loc")); } catch (e) {}
    });
  });
</script>

{%- if site.downtime %}
<dialog id="downDialog" class="w-[92vw] max-w-md rounded-2xl border-0 p-0 shadow-xl backdrop:bg-gray-900/50" dir="{{ t.dir }}">
  <div class="relative p-6 sm:p-7">
    <button type="button" onclick="document.getElementById('downDialog').close()" aria-label="close" class="absolute right-4 top-4 rtl:right-auto rtl:left-4 text-gray-400 hover:text-gray-600 z-10">
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/></svg>
    </button>

    {# STEP 1 — ask the question (no channel signposting yet) #}
    <form id="askStep">
      <h2 class="text-center text-lg font-semibold text-gray-900">{{ t.askDialogHeading or i18n.en.askDialogHeading }}</h2>
      <p class="mx-auto mt-2 max-w-sm text-center text-sm leading-6 text-gray-500">{{ t.askDialogSubtitle or i18n.en.askDialogSubtitle }}</p>
      <textarea id="askQ" rows="4" required maxlength="600" placeholder="{{ t.askPlaceholder or i18n.en.askPlaceholder }}"
        class="mt-4 block w-full resize-none rounded-md border-0 p-3 text-sm text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-green-600 text-start"></textarea>
      <div class="mt-5 flex justify-center">
        <button type="submit" class="inline-flex items-center justify-center rounded-full bg-gradient-to-br from-green-600 to-emerald-500 px-6 py-2.5 text-sm font-semibold text-white shadow-md transition hover:shadow-lg">{{ t.askSubmit or i18n.en.askSubmit }}</button>
      </div>
    </form>

    {# STEP 2 — split: which channel? (only after they've asked) #}
    <section id="chooseStep" class="hidden">
      <h2 class="text-center text-lg font-semibold text-gray-900">{{ t.chooseTitle or i18n.en.chooseTitle }}</h2>
      <p class="mx-auto mt-2 max-w-sm text-center text-sm leading-6 text-gray-500">{{ t.chooseSubtitle or i18n.en.chooseSubtitle }}</p>
      <div class="mt-5 space-y-3">
        <button type="button" id="pickTelegram" class="flex w-full items-center gap-3 rounded-xl px-4 py-3 text-start ring-1 ring-inset ring-gray-200 transition hover:ring-sky-400 hover:bg-sky-50">
          <svg class="h-7 w-7 shrink-0 fill-[#229ED9]" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.562 8.161c-.18 1.897-.962 6.502-1.359 8.627-.168.9-.5 1.201-.82 1.23-.696.064-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.209.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.139-5.061 3.345-.479.329-.913.489-1.302.481-.428-.009-1.252-.242-1.865-.442-.751-.244-1.349-.374-1.297-.788.027-.216.324-.437.892-.663 3.498-1.524 5.831-2.529 6.998-3.015 3.333-1.386 4.025-1.627 4.477-1.635.099-.002.321.023.465.14.121.099.155.232.171.326.016.093.036.306.02.472z"/></svg>
          <span class="flex-1">
            <span class="block text-sm font-semibold text-gray-900">{{ t.chooseTelegram or i18n.en.chooseTelegram }}</span>
            <span class="block text-xs text-emerald-600">{{ t.chooseTelegramHint or i18n.en.chooseTelegramHint }}</span>
          </span>
          <svg class="h-4 w-4 shrink-0 text-gray-400 rtl:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m9 5 7 7-7 7"/></svg>
        </button>
        <button type="button" id="pickWhatsApp" class="flex w-full items-center gap-3 rounded-xl px-4 py-3 text-start ring-1 ring-inset ring-gray-200 transition hover:ring-green-400 hover:bg-green-50">
          <svg class="h-7 w-7 shrink-0 fill-[#25D366]" viewBox="0 0 448 512" aria-hidden="true"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
          <span class="flex-1">
            <span class="block text-sm font-semibold text-gray-900">{{ t.chooseWhatsApp or i18n.en.chooseWhatsApp }}</span>
            <span class="block text-xs text-gray-500">{{ t.chooseWhatsAppHint or i18n.en.chooseWhatsAppHint }}</span>
          </span>
          <svg class="h-4 w-4 shrink-0 text-gray-400 rtl:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m9 5 7 7-7 7"/></svg>
        </button>
      </div>
    </section>

    {# STEP 3 — WhatsApp: capture number, notify later (question carried from step 1) #}
    <form id="downForm" class="hidden">
      <h2 class="text-center text-lg font-semibold text-gray-900">{{ t.downTitle or i18n.en.downTitle }}</h2>
      <p class="mx-auto mt-2 max-w-sm text-center text-sm leading-6 text-gray-500">{{ t.downBanner or i18n.en.downBanner }}</p>
      <div class="mt-4" dir="ltr">
        <input id="downPhone" type="tel" required autocomplete="tel" placeholder="{{ t.downPhonePlaceholder or i18n.en.downPhonePlaceholder }}"
          class="block w-full rounded-md border-0 p-3 text-sm text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-green-600" dir="ltr">
      </div>
      <input type="hidden" id="downQ">
      <input id="downHp" name="website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true">
      <p id="downMsg" class="mt-2 hidden text-center text-sm"></p>
      <div class="mt-5 flex justify-center">
        <button type="submit" id="downBtn"
          class="inline-flex items-center justify-center rounded-full bg-gradient-to-br from-green-600 to-emerald-500 px-6 py-2.5 text-sm font-semibold text-white shadow-md transition hover:shadow-lg">{{ t.downSubmit or i18n.en.downSubmit }}</button>
      </div>
    </form>
  </div>
</dialog>
<script src="/vendor/intl-tel-input/js/intlTelInputWithUtils.min.js"></script>
<script>
  (function () {
    var dlg = document.getElementById('downDialog');
    // While the assistant is down, BOTH hero buttons capture a number instead of opening
    // WhatsApp. Ask keeps the optional question box; Join is phone-only.
    // Country + phone entry uses intl-tel-input (the standard library): a searchable flag
    // dropdown baked into the field, auto-formatting, and validated E.164 output on submit.
    // Default country is inferred from the page locale so the common case is zero taps.
    var LOCALE_CC = { en:'gb', ar:'sa', ur:'pk', fa:'ir', ps:'af', so:'so', id:'id', ms:'my', tr:'tr', bn:'bd', hi:'in', ta:'in', sd:'pk', ha:'ng', sw:'ke', am:'et', uz:'uz', tg:'tj', kk:'kz', ky:'kg', az:'az', sq:'al', bs:'ba', tt:'ru', ug:'cn', ckb:'iq', ru:'ru', de:'de', fr:'fr', es:'es', pt:'pt', it:'it', nl:'nl' };
    var phoneInp = document.getElementById('downPhone');
    var iti = window.intlTelInput(phoneInp, {
      initialCountry: LOCALE_CC[(document.documentElement.lang || 'en').toLowerCase().split('-')[0]] || 'gb',
      separateDialCode: true,
      countrySearch: true,
      nationalMode: true
    });
    // Mirror the original flow: ASK FIRST (one question box, no channel signposting), then on
    // submit split into "which channel?". Three panels share the dialog: ask -> choose -> WhatsApp
    // notify form. Telegram is a deep link (opens the bot with the question prefilled).
    var askStep = document.getElementById('askStep');
    var chooseStep = document.getElementById('chooseStep');
    var downForm = document.getElementById('downForm');
    var askQ = document.getElementById('askQ');
    function showStep(el) {
      [askStep, chooseStep, downForm].forEach(function (n) { n.classList.add('hidden'); });
      el.classList.remove('hidden');
    }
    function openDown() { showStep(askStep); dlg.showModal(); setTimeout(function () { askQ.focus(); }, 50); }
    // Step 1 -> 2: they typed a question, now pick a channel.
    askStep.addEventListener('submit', function (e) { e.preventDefault(); showStep(chooseStep); });
    // Telegram: open the bot with the question prefilled (same shape as the pre-downtime flow).
    document.getElementById('pickTelegram').addEventListener('click', function () {
      var q = (askQ.value || '').trim();
      window.open('https://t.me/DeenFatwaBot?text=' + encodeURIComponent(q), '_blank', 'noopener');
      dlg.close();
    });
    // WhatsApp: carry the question into the hidden field, then collect a number to notify later.
    document.getElementById('pickWhatsApp').addEventListener('click', function () {
      document.getElementById('downQ').value = (askQ.value || '').trim();
      showStep(downForm); setTimeout(function () { phoneInp.focus(); }, 50);
    });
    var ask = document.getElementById('askBtn');
    if (ask) { var c = ask.cloneNode(true); ask.parentNode.replaceChild(c, ask); c.addEventListener('click', function (e) { e.preventDefault(); openDown(); }); }
    document.querySelectorAll('a[href^="https://wa.me/"]').forEach(function (a) {
      a.addEventListener('click', function (e) { e.preventDefault(); openDown(); });
    });
    // Close on backdrop click. A modal <dialog> reports e.target === the dialog itself only for
    // clicks on its ::backdrop; clicks on any child (form fields, and the floated country
    // dropdown which we append INTO the dialog) target that child, so the picker works normally.
    dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });
    document.getElementById('downForm').addEventListener('submit', function (e) {
      e.preventDefault();
      var btn = document.getElementById('downBtn'), msg = document.getElementById('downMsg');
      // intl-tel-input validates and returns a complete E.164 number (dial code + national,
      // trunk-0 handled), so the backend always gets a well-formed international number.
      if (!iti.isValidNumber()) {
        msg.classList.remove('hidden');
        msg.textContent = {{ (t.downError or i18n.en.downError) | dump | safe }}; msg.className = 'mt-2 text-center text-sm text-red-600';
        return;
      }
      var phone = iti.getNumber();
      btn.disabled = true;
      fetch('https://de7sa5lb36.execute-api.eu-west-2.amazonaws.com/signup', {
        method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ phone: phone, question: document.getElementById('downQ').value, website: document.getElementById('downHp').value })
      }).then(function (r) { return r.json(); }).then(function (d) {
        msg.classList.remove('hidden');
        if (d.ok) { msg.textContent = {{ (t.downThanks or i18n.en.downThanks) | dump | safe }}; msg.className = 'mt-2 text-center text-sm text-green-700'; document.getElementById('downForm').querySelectorAll('input,textarea,button[type=submit]').forEach(function (el) { el.disabled = true; }); }
        else { msg.textContent = {{ (t.downError or i18n.en.downError) | dump | safe }}; msg.className = 'mt-2 text-center text-sm text-red-600'; btn.disabled = false; }
      }).catch(function () {
        msg.classList.remove('hidden');
        msg.textContent = {{ (t.downError or i18n.en.downError) | dump | safe }}; msg.className = 'mt-2 text-center text-sm text-red-600'; btn.disabled = false;
      });
    });
  })();
</script>
{%- endif %}

</body>

</html>
